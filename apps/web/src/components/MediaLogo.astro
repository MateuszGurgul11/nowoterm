---
interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'light' } = Astro.props;
const src =
  theme === 'dark'
    ? '/assets/logo/logo-white.png'
    : '/assets/logo/logo-black.png';
---

<div class="media-ph media-ph--logo" data-reveal>
  <img src={src} alt="Novoterm Budownictwo" loading="lazy" />
</div>

