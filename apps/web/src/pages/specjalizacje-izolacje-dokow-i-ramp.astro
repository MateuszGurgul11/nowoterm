---
import Layout from "../layouts/Layout.astro";
const title = "Izolacje doków i ramp | Novoterm Budownictwo";
const description = "Termoizolacja bram wjazdowych, doków załadunkowych i ramp - redukcja strat ciepła w halach magazynowych. Uszczelnienia, opaski termiczne, kurtyny pęcherzowe. Wielkopolska.";
---

<Layout {title} {description} solidHeader={true}>
<main>
    <section class="page-hero">
      <div class="wrap">
        <nav class="crumbs" aria-label="Okruszki"><a href="/">Novoterm</a> <span class="sep">/</span> <span>Specjalizacje</span> <span class="sep">/</span> <span>Izolacje doków i ramp</span></nav>
        <h1 data-hero>Izolacje doków i ramp</h1>
        <p class="lead" data-hero>Termoizolacja bram wjazdowych, doków załadunkowych i ramp - mniej strat ciepła, mniej kondensacji i niższe koszty ogrzewania hali magazynowej.</p>
        <span class="rule" data-hero></span>
      </div>
    </section>

    <section class="section">
      <div class="wrap--narrow">
        <div class="section-head">
          <span class="label" data-reveal>Zakres prac</span>
          <h2 class="h-lg" data-reveal>Co wykonujemy</h2>
        </div>
        <div class="scope-list">
          <div class="scope-item" data-reveal><span class="no">01</span><span class="name">Izolacja segmentów bram wjazdowych i rolet</span><span class="tag">Bramy</span></div>
          <div class="scope-item" data-reveal><span class="no">02</span><span class="name">Uszczelnienia doków załadunkowych i opaski termiczne</span><span class="tag">Doki</span></div>
          <div class="scope-item" data-reveal><span class="no">03</span><span class="name">Izolacja ramp załadunkowych i pomostów</span><span class="tag">Rampy</span></div>
          <div class="scope-item" data-reveal><span class="no">04</span><span class="name">Kurtyny pęcherzowe i systemy uszczelniające</span><span class="tag">Uszczelnienia</span></div>
          <div class="scope-item" data-reveal><span class="no">05</span><span class="name">Modernizacja istniejących doków bez wymiany konstrukcji</span><span class="tag">Remont</span></div>
          <div class="scope-item" data-reveal><span class="no">06</span><span class="name">Prace w reżimie działającego magazynu</span><span class="tag">Logistyka</span></div>
        </div>
      </div>
    </section>

    <section class="section section--soft">
      <div class="wrap">
        <div class="section-head">
          <span class="label" data-reveal>Przewagi</span>
          <h2 class="h-lg" data-reveal>Dlaczego izolacja doków ma znaczenie</h2>
        </div>
        <div class="info-cards">
          <div class="info-card" data-reveal><span class="ic-label">Energia</span><h3>Niższe koszty ogrzewania hali</h3><p>Uszczelnione doki i izolowane bramy ograniczają straty ciepła przy każdym cyklu załadunku.</p></div>
          <div class="info-card" data-reveal><span class="ic-label">Komfort</span><h3>Mniej kondensacji i przeciągów</h3><p>Lepsze warunki pracy przy bramach - stabilna temperatura i wilgotność w strefie załadunku.</p></div>
          <div class="info-card" data-reveal><span class="ic-label">Trwałość</span><h3>Odporność na intensywne użytkowanie</h3><p>Materiały i systemy dobrane pod codzienny ruch wózków widłowych i wielokrotne otwarcia.</p></div>
          <div class="info-card" data-reveal><span class="ic-label">Czas</span><h3>Montaż bez zatrzymania magazynu</h3><p>Etapowanie prac dok po doku - logistyka idzie dalej, izolacja rośnie etapami.</p></div>
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="wrap">
        <span class="label" data-reveal>Kontakt</span>
        <h2 data-reveal>Chcesz ograniczyć straty ciepła przy dokach? Wycenimy zakres.</h2>
        <a class="btn btn--light" href="/kontakt" data-reveal>Zapytanie ofertowe</a>
      </div>
    </section>
  </main>
</Layout>
