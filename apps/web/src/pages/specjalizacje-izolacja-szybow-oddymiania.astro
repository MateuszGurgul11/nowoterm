---
import Layout from "../layouts/Layout.astro";
const title = "Izolacja szybów oddymiania | Novoterm Budownictwo";
const description = "Izolacja termiczna i akustyczna szybów oddymiania w halach i budynkach użyteczności publicznej. Wełna mineralna, uszczelnienia, obudowy - zgodnie z wymaganiami p.poż.";
---

<Layout {title} {description} solidHeader={true}>
<main>
    <section class="page-hero">
      <div class="wrap">
        <nav class="crumbs" aria-label="Okruszki"><a href="/">Novoterm</a> <span class="sep">/</span> <span>Specjalizacje</span> <span class="sep">/</span> <span>Izolacja szybów oddymiania</span></nav>
        <h1 data-hero>Izolacja szybów oddymiania</h1>
        <p class="lead" data-hero>Termoizolacja i obudowy szybów oddymiania w halach przemysłowych i budynkach użyteczności publicznej - szczelność dymowa, odporność termiczna i zgodność z projektem pożarowym.</p>
        <span class="rule" data-hero></span>
      </div>
    </section>

    <section class="section">
      <div class="wrap--narrow">
        <div class="section-head">
          <span class="label" data-reveal>Zakres prac</span>
          <h2 class="h-lg" data-reveal>Co wykonujemy</h2>
        </div>
        <div class="scope-list">
          <div class="scope-item" data-reveal><span class="no">01</span><span class="name">Izolacja wełną mineralną i płytami o podwyższonej odporności ogniowej</span><span class="tag">Termoizolacja</span></div>
          <div class="scope-item" data-reveal><span class="no">02</span><span class="name">Uszczelnienia i obudowy kanałów oddymiania</span><span class="tag">Szczelność</span></div>
          <div class="scope-item" data-reveal><span class="no">03</span><span class="name">Montaż płyt i okładzin na konstrukcji stalowej szybu</span><span class="tag">Obudowa</span></div>
          <div class="scope-item" data-reveal><span class="no">04</span><span class="name">Prace na wysokości z pełnym reżimem BHP</span><span class="tag">Bezpieczeństwo</span></div>
          <div class="scope-item" data-reveal><span class="no">05</span><span class="name">Koordynacja z instalacją wentylacji pożarowej</span><span class="tag">Branże</span></div>
          <div class="scope-item" data-reveal><span class="no">06</span><span class="name">Dokumentacja powykonawcza i protokoły odbioru</span><span class="tag">Odbiór</span></div>
        </div>
      </div>
    </section>

    <section class="section section--soft">
      <div class="wrap">
        <div class="section-head">
          <span class="label" data-reveal>Przewagi</span>
          <h2 class="h-lg" data-reveal>Dlaczego warto powierzyć nam szyby oddymiania</h2>
        </div>
        <div class="info-cards">
          <div class="info-card" data-reveal><span class="ic-label">Szczelność</span><h3>Ochrona przed przenikaniem dymu</h3><p>Uszczelnienia i obudowy wykonane zgodnie z projektem pożarowym - bez luk w strefach oddymiania.</p></div>
          <div class="info-card" data-reveal><span class="ic-label">Temperatura</span><h3>Odporność na ekstremalne warunki</h3><p>Materiały dobrane pod kątem pracy w podwyższonych temperaturach i cykli oddymiania.</p></div>
          <div class="info-card" data-reveal><span class="ic-label">Wysokość</span><h3>Doświadczenie w pracy na wysokości</h3><p>Platformy robocze, uprząże, szkolenia - montaż w szybach o dużej wysokości bez kompromisów BHP.</p></div>
          <div class="info-card" data-reveal><span class="ic-label">Dokumentacja</span><h3>Pełna ścieżka odbiorowa</h3><p>Protokoły, karty materiałowe i zgodność z wymaganiami inwestora i nadzoru pożarowego.</p></div>
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="wrap">
        <span class="label" data-reveal>Kontakt</span>
        <h2 data-reveal>Planujesz izolację szybów oddymiania? Ustalmy zakres.</h2>
        <a class="btn btn--light" href="/kontakt" data-reveal>Zapytanie ofertowe</a>
      </div>
    </section>
  </main>
</Layout>
