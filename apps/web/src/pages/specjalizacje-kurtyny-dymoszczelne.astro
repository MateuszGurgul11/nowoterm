---
import Layout from "../layouts/Layout.astro";
const title = "Kurtyny dymoszczelne — montaż i serwis | Novoterm Budownictwo";
const description = "Montaż i serwis kurtyn dymoszczelnych: podział stref pożarowych, ochrona ciągów ewakuacyjnych, integracja z systemem pożarowym. Wielkopolska.";
---

<Layout {title} {description} solidHeader={true}>
<main>
    <section class="page-hero">
      <div class="wrap">
        <nav class="crumbs" aria-label="Okruszki"><a href="/">Novoterm</a> <span class="sep">/</span> <span>Specjalizacje</span> <span class="sep">/</span> <span>Kurtyny dymoszczelne</span></nav>
        <h1 data-hero>Kurtyny dymoszczelne</h1>
        <p class="lead" data-hero>Montaż i serwis kurtyn dymoszczelnych — podział stref pożarowych, ochrona ciągów ewakuacyjnych i integracja z systemem sterowania pożarowego obiektu.</p>
        <span class="rule" data-hero></span>
      </div>
    </section>

    <section class="section">
      <div class="wrap--narrow">
        <div class="section-head">
          <span class="label" data-reveal>Zakres prac</span>
          <h2 class="h-lg" data-reveal>Co wykonujemy</h2>
        </div>
        <div class="scope-list">
          <div class="scope-item" data-reveal><span class="no">01</span><span class="name">Dobór systemu kurtyny pod projekt pożarowy obiektu</span><span class="tag">Projekt</span></div>
          <div class="scope-item" data-reveal><span class="no">02</span><span class="name">Montaż kurtyn tkaninowych i panelowych</span><span class="tag">Montaż</span></div>
          <div class="scope-item" data-reveal><span class="no">03</span><span class="name">Integracja z BMS i centralą pożarową</span><span class="tag">Automatyka</span></div>
          <div class="scope-item" data-reveal><span class="no">04</span><span class="name">Uruchomienie, testy i protokoły odbioru</span><span class="tag">Odbiór</span></div>
          <div class="scope-item" data-reveal><span class="no">05</span><span class="name">Przeglądy okresowe i naprawy pogwarancyjne</span><span class="tag">Serwis</span></div>
          <div class="scope-item" data-reveal><span class="no">06</span><span class="name">Wymiana tkanin i elementów napędu</span><span class="tag">Serwis</span></div>
        </div>
      </div>
    </section>

    <section class="section section--soft">
      <div class="wrap">
        <div class="section-head">
          <span class="label" data-reveal>Przewagi</span>
          <h2 class="h-lg" data-reveal>Dlaczego kurtyny dymoszczelne od Novoterm</h2>
        </div>
        <div class="info-cards">
          <div class="info-card" data-reveal><span class="ic-label">Systemy</span><h3>Certyfikowane rozwiązania</h3><p>Montujemy kurtyny producentów z pełną dokumentacją i deklaracjami właściwości użytkowych.</p></div>
          <div class="info-card" data-reveal><span class="ic-label">Zgodność</span><h3>Realizacja wg projektu poż.</h3><p>Każdy montaż zgodny z dokumentacją projektową i wymaganiami miejscowego nadzoru pożarowego.</p></div>
          <div class="info-card" data-reveal><span class="ic-label">Czas</span><h3>Krótkie okna montażowe</h3><p>Prace planujemy pod przestoje obiektu — weekendy, nocne zmiany, etapowanie bez blokady całego budynku.</p></div>
          <div class="info-card" data-reveal><span class="ic-label">Serwis</span><h3>Opieka po montażu</h3><p>Przeglądy, naprawy i wymiana elementów — kurtyna gotowa do działania, gdy tego wymaga sytuacja.</p></div>
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="wrap">
        <span class="label" data-reveal>Kontakt</span>
        <h2 data-reveal>Potrzebujesz kurtyn dymoszczelnych? Porozmawiajmy o zakresie.</h2>
        <a class="btn btn--light" href="/kontakt" data-reveal>Zapytanie ofertowe</a>
      </div>
    </section>
  </main>
</Layout>
